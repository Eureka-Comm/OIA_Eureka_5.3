# Required
DOMAIN=chat.tu-dominio.com
SITE_USER=eureka
SITE_PASSWORD_HASH='pega-aqui-el-hash-bcrypt'
# Set this to SITE_USER only when that Basic Auth account is dedicated to the Eureka-0 reviewer.
# Leave blank to keep proposal review read-only.
EUREKA_ZERO_REVIEW_USERNAME=
# Eureka Runtime API (generate a private random bearer token for the internal app/runtime connection)
EUREKA_RUNTIME_API_TOKEN=
# Optional comma-separated browser origins allowed to call /api/v1 with an API key.
EUREKA_API_CORS_ORIGINS=

# Provider for Eureka's inference engine. Use `responses` for Responses API
# providers, or `chat_completions` for OpenAI-compatible Chat Completions (e.g. Ollama).
MODEL_API_URL=https://api.openai.com/v1/responses
MODEL_API_PROTOCOL=responses
MODEL_API_KEY=
MODEL_API_AUTH_MODE=bearer
MODEL_API_ALLOW_HTTP=false
MODEL_NAME=
MODEL_MAX_OUTPUT_TOKENS=3000
MODEL_TIMEOUT_MS=120000

# Optional local Ollama setup (enable with `docker compose --profile local-inference up -d --build`):
# MODEL_API_URL=http://ollama:11434/v1/chat/completions
# MODEL_API_PROTOCOL=chat_completions
# MODEL_API_AUTH_MODE=none
# MODEL_API_ALLOW_HTTP=true
# MODEL_NAME=<model-tag-pulled-on-the-VPS>

# Optional; these are placeholders until each service is integrated.
EM_FACTORY_MCP_URL=
EM_FACTORY_OAUTH_TOKEN=
MATH_ENGINE_URL=

