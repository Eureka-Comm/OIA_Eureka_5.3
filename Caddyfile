{
	default_sni {$DOMAIN}
}

{$DOMAIN} {
  encode zstd gzip

	tls {
		issuer acme {
			profile shortlived
		}
	}

  @eureka_api path /api/v1/*
  handle @eureka_api {
    reverse_proxy app:3000
  }

  handle {
    basic_auth {
      {$SITE_USER} {$SITE_PASSWORD_HASH}
    }
    reverse_proxy app:3000
  }
}
